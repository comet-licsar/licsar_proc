#!/bin/bash
extra="--account=nceo_geohazards "
if [ ! -z $2 ]; then
  echo "second param provided - increasing mem to 32G"
  extra=$extra" --mem=32G"
else
  extra=$extra" --mem=16G"
fi
if [ ! -z $1 ]; then
  if [ $1 == 3 ]; then
    inter $extra
  elif [ $1 == 4 ]; then
    inter4 $extra
  elif [ $1 == 6 ]; then
    inter6 $extra
  else
    echo "wrong number - setting to 3h"
    inter $extra
  fi
else
 echo "Usage: interlics 4 [1]"
 echo "this would run interactive LOTUS session for 4 hours"
 echo "currently the number should be 3, 4 or 6 - any other number would default to 3h"
 echo "optional parameter 1 would increase requested RAM to 32G instead of default 16G"
fi
